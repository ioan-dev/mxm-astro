---
import Footer from '../components/Footer.astro';
import HeaderHome from '../components/HeaderHome.astro';
import '../styles/main.css';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Title</title>
    <meta name="description" content="description" />
  </head>
  <body>
    <HeaderHome />
    <slot />
    <Footer />
  </body>
</html>

<style>
  html {
    scrollbar-gutter: stable;
  }

  @media (--tablet) {
    .footer__contacts {
      display: none;
    }
  }
</style>

<script>
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';

  const lenis = new Lenis({
    autoRaf: true,
  });

  const seen = localStorage.getItem('preloader-seen');

  if (!seen) {
    // Первый визит — прелоадер будет показан, блокируем скролл
    lenis.stop();

    window.addEventListener('preloader:complete', () => {
      lenis.start();
    });
  }
</script>
