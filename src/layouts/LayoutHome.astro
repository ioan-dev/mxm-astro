---
import Footer from '../components/Footer.astro';
import HeaderHome from '../components/HeaderHome.astro';
import '../styles/main.css';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Title</title>
    <meta name="description" content="description" />
  </head>
  <body>
    <HeaderHome />
    <slot />
    <Footer />
  </body>
</html>

<style>
  html {
    scrollbar-gutter: stable;
  }

  @media (--tablet) {
    .footer__contacts {
      display: none;
    }
  }
</style>

<script>
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';

  const lenis = new Lenis({
    autoRaf: true,
  });

  const seen = localStorage.getItem('preloader-seen');

  if (!seen) {
    lenis.stop();
    window.addEventListener('preloader:complete', () => {
      lenis.start();
    });
  }

  // === ПЕРЕКЛЮЧЕНИЕ ТЕМЫ ===
  const root = document.documentElement;
  const savedTheme = localStorage.getItem('theme');

  if (savedTheme === 'light' || savedTheme === 'dark') {
    root.dataset.theme = savedTheme;
  }

  function toggleTheme(event: Event) {
    event.preventDefault();
    event.stopPropagation();
    event.stopImmediatePropagation();

    const currentTheme = root.dataset.theme || 'dark';
    const nextTheme = currentTheme === 'light' ? 'dark' : 'light';

    root.dataset.theme = nextTheme;
    localStorage.setItem('theme', nextTheme);
  }

  function initThemeButtons() {
    const buttons = document.querySelectorAll('[data-theme-toggle]');

    buttons.forEach((btn) => {
      // Используем capture phase для перехвата события ДО всплытия
      btn.removeEventListener('click', toggleTheme, true);
      btn.addEventListener('click', toggleTheme, true);
    });
  }

  // Используем astro:page-load для поддержки View Transitions
  document.addEventListener('astro:page-load', initThemeButtons);

  // Запускаем сразу для первой загрузки
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThemeButtons);
  } else {
    initThemeButtons();
  }
</script>
