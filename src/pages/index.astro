---
import Layout from "../layouts/Layout.astro";
import { client, readSingleton } from "../lib/directus.js";

// readSingleton — специальный метод для синглтон-коллекций
// (тех, у которых включена настройка "Singleton" в Directus)
const page = await client.request(
  readSingleton("page_home", {
    fields: ["*", "blocks.*", "blocks.item.*"],
  }),
);
---

<Layout />
