---
import Layout from '../layouts/LayoutHome.astro';
import HeroImageScroll from '../components/sections/HeroImageScroll.astro';
import HomePageTeam from '../components/HomePageTeam.astro';
import { getHomePage } from '../lib/queries/page-home.ts';
import HomePageAbout from '../components/HomePageAbout.astro';
import { safeJsonDebug } from '../utils/jsonHelpers';
import Logo from '../components/Logo.astro';
import { login } from '@directus/sdk';
import HomePageProjects from '../components/HomePageProjects.astro';
import HomePageSecvices from '../components/HomePageServices.astro';
import HomePageForm from '../components/HomePageForm.astro';
import Preloader from '../components/Preloader.astro';
import LayoutHome from '../layouts/LayoutHome.astro';
import Modal from '../components/Modal.astro';
import MobileMenu from '../components/Mobile-menu.astro';

// Один вызов — вся логика скрыта в отдельном файле
const page = await getHomePage();
const { blocks, socialLinks } = page;

type BlockType = 'block_homepage_hero' | 'block_homepage_team' | 'block_homepage_about';

const BlockComponents = {
  block_homepage_hero: HeroImageScroll,
  block_homepage_team: HomePageTeam,
  block_homepage_about: HomePageAbout,
  block_homepage_projects: HomePageProjects,
  block_homepage_services: HomePageSecvices,
  block_homepage_form: HomePageForm,
} as const;
---

<!-- <pre>
  {safeJsonDebug(blocks )}
</pre> -->
<LayoutHome>
  <div class="page-wrapper flow flow-space-large">
    {
      blocks.map((block: any) => {
        const Component = BlockComponents[block.collection as BlockType];

        if (!Component) {
          console.warn(`Неизвестный тип блока: ${block.collection}`);
          return null;
        }

        const extraProps = ['block_homepage_form'].includes(block.collection)
          ? { socialLinks }
          : {};

        return <Component {...block} {...extraProps} />;
      })
    }
  </div>

  <Preloader />
  <MobileMenu />
  <Modal />
</LayoutHome>

<style>
  .page-wrapper {
    overflow: clip;
  }

  /* Responsive */

  @media (--tablet) {
    .page-wrapper {
      /* padding-top: 100px; */
    }
  }
</style>
