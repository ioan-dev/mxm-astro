---
import Layout from "../layouts/Layout.astro";
import HeroImageScroll from "../components/sections/HeroImageScroll.astro";
import HomePageTeam from "../components/HomePageTeam.astro";
import { getHomePage } from "../lib/queries/page-home.ts";

// Один вызов — вся логика скрыта в отдельном файле
const page = await getHomePage();
const { blocks } = page;

type BlockType = "block_homepage_hero" | "block_homepage_team";

const BlockComponents = {
  block_homepage_hero: HeroImageScroll,
  block_homepage_team: HomePageTeam,
} as const;
---

<Layout>
  {
    blocks.map((block: any) => {
      const Component = BlockComponents[block.collection as BlockType];

      if (!Component) {
        console.warn(`Неизвестный тип блока: ${block.collection}`);
        return null;
      }

      return <Component {...block} />;
    })
  }
</Layout>
