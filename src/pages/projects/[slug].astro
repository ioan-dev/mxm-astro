---
import { safeJsonDebug } from '../../utils/jsonHelpers';
// src/pages/projects/[slug].astro

import { getAllProjects, getProjectBySlug } from '../../lib/queries/projects.js';
import Layout from '../../layouts/Layout.astro';
import ProjectsHero from '../../components/ProjectsHero.astro';
import ProjectsIntro from '../../components/ProjectsIntro.astro';
import BlockImages from '../../components/BlockImages.astro';
import BlockText from '../../components/BlockText.astro';
import { projects } from '../../lib/queries/projects.js';

export async function getStaticPaths() {
  const projects = await getAllProjects();

  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = await getProjectBySlug(slug);

if (!project) {
  return Astro.redirect('/404');
}

const blockComponents: Record<string, any> = {
  block_projects_hero: ProjectsHero,
  block_projects_intro: ProjectsIntro,
  block_text: BlockText,
  block_images: BlockImages,
};

const sorted = [...projects].sort((a, b) => a.sort - b.sort);
const currentIndex = sorted.findIndex((p) => p.slug === slug);

const prevProject = sorted[(currentIndex - 1 + sorted.length) % sorted.length];
const nextProject = sorted[(currentIndex + 1) % sorted.length];
---

<Layout isProject>
  <div class="page-wrapper flow">
    <!-- <pre>
      {safeJsonDebug( projects )}
    </pre> -->

    {
      project.blocks?.map((block: any) => {
        const Component = blockComponents[block.collection];
        // Если компонент не найден — пропускаем блок
        if (!Component) return null;

        // Рендерим компонент, передавая данные блока как пропсы
        return (
          <Component
            {...block.item}
            projectTitle={project.title}
            projectDate={project.date}
            projectStage={project.stage.name}
            projectTeam={project.team}
            projectCategories={project.categories}
            projectAreas={project.areas}
          />
        );
      })
    }

    <div class="switch-projects">
      <div class="wrapper">
        <div class="repel">
          <a href={`/projects/${prevProject.slug}`} class="switch-projects__item">
            <h3 class="heading-medium">{prevProject.title}</h3>
            <p class="text-small">Предыдущий проект</p>
          </a>

          <a href={`/projects/${nextProject.slug}`} class="switch-projects__item">
            <h3 class="heading-medium">{nextProject.title}</h3>
            <p class="text-small">Следующий проект</p>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-wrapper {
    --flow-space: var(--spacing-16);
    padding-top: 250px;
  }

  .switch-projects {
    padding-block: 200px;
  }

  .switch-projects__item {
    display: flex;
    column-gap: var(--spacing-2);
  }
</style>
