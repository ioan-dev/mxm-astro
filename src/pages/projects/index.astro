---
import ButtonLink from '../../components/Button-link.astro';
import Layout from '../../layouts/Layout.astro';
import { ASSETS_URL } from '../../lib/constants';
import { Image } from '@unpic/astro';
import { getAllProjectsForCatalog } from '../../lib/queries/projects.js';
const projects = await getAllProjectsForCatalog();
import { safeJsonDebug } from '../../utils/jsonHelpers';
import { categories } from '../../lib/queries/categories';
import { locations } from '../../lib/queries/location';
import Button from '../../components/Button.astro';
import MobileMenu from '../../components/Mobile-menu.astro';
---

<Layout>
  <div class="page-wrapper">
    <!-- <pre>
      {safeJsonDebug( projects )}
    </pre> -->

    <div class="wrapper">
      <div class="flow">
        <div class="filters-top">
          <div class="filters-top__inner grid">
            <div class="filters-top__categories">
              <ButtonLink class:list={['is-active']} data-filter="category" data-value=""
                >Все</ButtonLink
              >
              {
                categories.map((item) => {
                  return (
                    <ButtonLink data-filter="category" data-value={item.name}>
                      {item.name}
                    </ButtonLink>
                  );
                })
              }
            </div>
            <div class="filters-top__location">
              <ButtonLink class:list={['is-active']} data-filter="location" data-value=""
                >Все</ButtonLink
              >
              {
                locations.map((item) => {
                  return (
                    <ButtonLink data-filter="location" data-value={item.name}>
                      {item.name}
                    </ButtonLink>
                  );
                })
              }
            </div>
          </div>
        </div>

        <div class="projects grid">
          <div class="projects__case-wrapper flow">
            {
              projects.map((project) => {
                const cats =
                  project.categories
                    ?.map((c: any) => c.categories_id?.name)
                    .filter(Boolean) // убираем null/undefined на случай пустых записей
                    .join(',') ?? '';
                // Локация — берём первый элемент массива (или пустую строку)
                const loc = project.location?.name ?? '';
                return (
                  <a
                    class="projects__case"
                    href={`/projects/${project.slug}`}
                    data-slug={project.slug}
                    data-categories={cats}
                    data-location={loc}
                  >
                    <h2 class="heading-medium">{project.title}</h2>
                    <span class="text-small">{project.date}</span>
                  </a>
                );
              })
            }
          </div>

          <div class="projects__previews-wrapper flow">
            {
              projects.map((project: any) => {
                let preview = project.preview;
                const cats =
                  project.categories
                    ?.map((c: any) => c.categories_id?.name)
                    .filter(Boolean) // убираем null/undefined на случай пустых записей
                    .join(',') ?? '';
                // Локация — берём первый элемент массива (или пустую строку)
                const loc = project.location?.name ?? '';
                return (
                  <a
                    class="projects__previews grid"
                    href={`/projects/${project.slug}`}
                    data-slug={project.slug}
                    data-categories={cats}
                    data-location={loc}
                  >
                    {preview.map((item: any) => {
                      if (!item.directus_files_id) return null;
                      return (
                        <div class="frame">
                          <Image
                            alt=""
                            layout="constrained"
                            src={`${ASSETS_URL}/${item.directus_files_id.id}`}
                            width={item.directus_files_id.width}
                            height={item.directus_files_id.height}
                            cdn="directus"
                          />
                        </div>
                      );
                    })}
                    <span class="projects__previews-name text-small">{project.title}</span>
                  </a>
                );
              })
            }
            <div class="spacer"></div>
          </div>
        </div>

        <div class="projects-mobile grid">
          {
            projects.map((project) => {
              const cats =
                project.categories
                  ?.map((c: any) => c.categories_id?.name)
                  .filter(Boolean) // убираем null/undefined на случай пустых записей
                  .join(',') ?? '';
              // Локация — берём первый элемент массива (или пустую строку)
              const loc = project.location?.name ?? '';
              return (
                <div class="projects-mobile__item">
                  <a
                    class="projects__case"
                    href={`/projects/${project.slug}`}
                    data-slug={project.slug}
                    data-categories={cats}
                    data-location={loc}
                  >
                    <div class="frame">
                      <Image
                        alt=""
                        layout="constrained"
                        src={`${ASSETS_URL}/${project.preview_mobile?.id}`}
                        width={project.preview_mobile?.width}
                        height={project.preview_mobile?.height}
                        cdn="directus"
                      />
                    </div>
                    <h2 class="text-small text-color-primary">{project.title}</h2>
                  </a>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>

    <div class="filters">
      <div class="filters__content">
        <div class="filters__categories">
          <ButtonLink class:list={['is-active']} data-filter="category" data-value=""
            >Все</ButtonLink
          >
          {
            categories.map((item) => {
              return (
                <ButtonLink data-filter="category" data-value={item.name}>
                  {item.name}
                </ButtonLink>
              );
            })
          }
        </div>
        <div class="filters__locations">
          <ButtonLink class:list={['is-active']} data-filter="location" data-value=""
            >Все</ButtonLink
          >
          {
            locations.map((item) => {
              return (
                <ButtonLink data-filter="location" data-value={item.name}>
                  {item.name}
                </ButtonLink>
              );
            })
          }
        </div>
      </div>
      <Button>Фильтры</Button>
    </div>

    <div class="shadow"></div>
  </div>
  <MobileMenu />
</Layout>

<style>
  .page-wrapper {
    --flow-space: var(--spacing-8);
    padding-top: 30vh;
  }

  :is(.filters-top__categories, .filters-top__location) {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--spacing-3);
    row-gap: var(--spacing-2);
  }

  .filters-top__categories {
    grid-column: span 6;

    .button-link {
      color: var(--color-text-secondary);
    }

    .button-link.is-active {
      color: var(--color-text-primary);
    }
  }

  .filters-top__location {
    grid-column: span 3 / -1;
    justify-self: end;
    align-items: flex-end;
    align-content: flex-end;
    justify-content: flex-end;

    .button-link {
      color: var(--color-text-secondary);
    }

    .button-link.is-active {
      color: var(--color-text-primary);
    }
  }

  .projects {
    position: relative;
    align-items: start;
  }

  .filters {
    position: fixed;

    display: flex;
    flex-direction: column;
    bottom: var(--spacing-4);
    right: var(--spacing-4);
    z-index: 10;
    gap: var(--spacing-2);
    max-width: 302px;

    .button {
      width: 302px;
    }

    .button-link {
      color: var(--color-text-secondary);
    }

    .button-link.is-active {
      color: var(--color-text-primary-inverse);
    }
  }

  .filters__content {
    background-color: var(--color-bg-primary-inverse);
    color: var(--color-text-primary-inverse);
    padding: var(--spacing-4);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
    border-radius: var(--border-radius-m);
    opacity: 0;
    visibility: hidden;
  }

  .filters__content.is-active {
    opacity: 1;
    visibility: visible;
  }

  .filters__categories {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .filters__locations {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
  }

  .shadow {
    position: fixed;
    bottom: 0;
    width: 100%;
    height: 50px;
    background: linear-gradient(180deg, rgba(13, 13, 13, 0) 0%, rgba(13, 13, 13, 0.5) 100%);
    pointer-events: none;
  }

  .spacer {
    height: 30vh;
  }

  .projects__case-wrapper {
    --flow-space: var(--spacing-2);
    grid-column: span 3;

    position: sticky;
    top: 30vh;
  }
  .projects__previews-wrapper {
    grid-column: 5 / -1;
    overflow: hidden;
  }
  .projects__case {
    display: flex;
    column-gap: var(--spacing-2);
    justify-content: space-between;
    align-items: flex-start;
    color: var(--color-text-secondary);

    cursor: pointer;
  }

  .projects__case.is-active {
    color: var(--color-text-primary);
  }

  .projects__previews {
    --flow-space: var(--spacing-12);
    --columns: 8;
    position: relative;

    img {
      max-width: 100% !important;
      max-height: 100% !important;
    }
  }

  .projects__previews.is-active {
    & > .frame > img {
      filter: grayscale(0);
    }
  }

  .projects__previews-name {
    position: absolute;
    color: var(--color-text-primary);
    pointer-events: none;
    z-index: 10;
  }

  .frame {
    grid-column: span 2;
    align-items: flex-start;
    position: relative;

    & > img {
      height: auto;
    }
  }

  /* Responsive */

  @media (--tablet-above) {
    .projects-mobile {
      display: none;
    }

    .frame {
      & > img {
        filter: grayscale(1);
        transition: filter 0.2s ease;
      }
    }
  }

  @media (--tablet) {
    .page-wrapper {
      --flow-space: 0px;
      padding-top: 90px;
    }
    .projects {
      display: none;
    }
    .filters-top {
      display: none;
    }

    .projects-mobile {
      row-gap: var(--spacing-4);
    }

    .projects-mobile__item {
      grid-column: span 2;

      h2 {
        padding-top: 4px;
        padding-left: 4px;
      }
    }

    .projects__case {
      display: flex;
      flex-direction: column;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const nav = document.querySelector('.projects__case-wrapper');
  const content = document.querySelector('.projects__previews-wrapper');
  let contentHeight = content?.clientHeight;
  let contentTopPadding = content?.getBoundingClientRect().top;
  console.log(contentTopPadding);

  let tlMoveCase = gsap.timeline();

  tlMoveCase.to(nav, {
    yPercent: -50,
    duration: 5,
    scrollTrigger: {
      trigger: content,
      start: 'top 30%',
      // markers: true,
      scrub: true,
    },
  });

  let filtersBtn = document.querySelector('.filters .button');
  let filterContent = document.querySelector('.filters__content');

  filtersBtn?.addEventListener('click', () => {
    filterContent?.classList.toggle('is-active');
  });

  // Адаптировать логику перемещения под кейсы
  // Появление из opacity а не маски

  namePreviewAnimation();

  function namePreviewAnimation() {
    const previews = document.querySelectorAll('.projects__previews');

    previews.forEach((previewItem) => {
      const caseName = previewItem.querySelector('.projects__previews-name');
      if (!caseName) return;

      // Смещение от курсора (подстрой под себя)
      const offsetX = 20;
      const offsetY = 20;

      gsap.set(caseName, { autoAlpha: 0 });

      const xTo = gsap.quickTo(caseName, 'x', { duration: 0.6, ease: 'power3' });
      const yTo = gsap.quickTo(caseName, 'y', { duration: 0.6, ease: 'power3' });

      const handleMouseMove = (e) => {
        const rect = previewItem.getBoundingClientRect();
        xTo(e.clientX - rect.left + offsetX);
        yTo(e.clientY - rect.top + offsetY);
      };

      previewItem.addEventListener('mouseenter', (e) => {
        const rect = previewItem.getBoundingClientRect();

        // СРАЗУ ставим рядом с курсором, без анимации
        gsap.set(caseName, {
          x: e.clientX - rect.left + offsetX,
          y: e.clientY - rect.top + offsetY,
        });

        // Потом плавно проявляем
        gsap.to(caseName, { autoAlpha: 1, duration: 0.3 });

        previewItem.addEventListener('mousemove', handleMouseMove);
      });

      previewItem.addEventListener('mouseleave', () => {
        gsap.to(caseName, { autoAlpha: 0, duration: 0.1 });
        previewItem.removeEventListener('mousemove', handleMouseMove);
      });
    });
  }
  // function namePreviewAnimation() {
  //   const previews = document.querySelectorAll('.projects__previews');

  //   previews.forEach((previewItem) => {
  //     const caseName = previewItem.querySelector('.projects__previews-name');
  //     if (!caseName) return;

  //     gsap.set(caseName, { xPercent: 50, yPercent: 60, autoAlpha: 0 });

  //     const xTo = gsap.quickTo(caseName, 'x', { duration: 0.6, ease: 'power3' });
  //     const yTo = gsap.quickTo(caseName, 'y', { duration: 0.6, ease: 'power3' });

  //     // Следование за курсором
  //     previewItem.addEventListener('mousemove', (e) => {
  //       const rect = previewItem.getBoundingClientRect();
  //       xTo(e.clientX - rect.left);
  //       yTo(e.clientY - rect.top);
  //       gsap.to(caseName, { autoAlpha: 1, duration: 0.3 });
  //     });

  //     previewItem.addEventListener('mouseleave', (e) => {
  //       gsap.to(caseName, { autoAlpha: 0, duration: 0.1 });
  //     });
  //   });
  // }

  function initHoverSync() {
    const cases = document.querySelectorAll('.projects__case');
    const previews = document.querySelectorAll('.projects__previews');

    const syncBySlug = (slug, isActive) => {
      const caseEl = document.querySelector(`.projects__case[data-slug="${slug}"]`);
      const previewEl = document.querySelector(`.projects__previews[data-slug="${slug}"]`);

      if (isActive) {
        caseEl?.classList.add('is-active');
        previewEl?.classList.add('is-active');
      } else {
        caseEl?.classList.remove('is-active');
        previewEl?.classList.remove('is-active');
      }
    };

    cases.forEach((caseEl) => {
      caseEl.addEventListener('mouseenter', () => syncBySlug(caseEl.dataset.slug, true));
      caseEl.addEventListener('mouseleave', () => syncBySlug(caseEl.dataset.slug, false));
    });

    previews.forEach((previewEl) => {
      previewEl.addEventListener('mouseenter', () => syncBySlug(previewEl.dataset.slug, true));
      previewEl.addEventListener('mouseleave', () => syncBySlug(previewEl.dataset.slug, false));
    });
  }

  // На:
  document.addEventListener('DOMContentLoaded', () => {
    initHoverSync();
    initFilters();
  });

  // И добавить саму функцию:
  function initFilters() {
    const active = { category: '', location: '' };
    const filterBtns = document.querySelectorAll('[data-filter]');

    function applyFilters() {
      const cases = document.querySelectorAll('.projects__case');
      const previews = document.querySelectorAll('.projects__previews');

      function isVisible(el) {
        const elCats = el.dataset.categories || '';
        const elLoc = el.dataset.location || '';
        const catMatch = active.category === '' || elCats.split(',').includes(active.category);
        const locMatch = active.location === '' || elLoc === active.location;
        return catMatch && locMatch;
      }

      cases.forEach((el) => {
        el.style.display = isVisible(el) ? '' : 'none';
      });
      previews.forEach((el) => {
        el.style.display = isVisible(el) ? '' : 'none';
      });
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filterType = btn.dataset.filter;
        const filterValue = btn.dataset.value;

        active[filterType] = filterValue;

        // Снимаем is-active со всех кнопок этого типа — в ОБОИХ панелях
        document
          .querySelectorAll(`[data-filter="${filterType}"]`)
          .forEach((b) => b.classList.remove('is-active'));

        // Ставим is-active на все кнопки с тем же value — тоже в обоих панелях
        // Это синхронизирует .filters-top и .filters между собой
        document
          .querySelectorAll(`[data-filter="${filterType}"][data-value="${filterValue}"]`)
          .forEach((b) => b.classList.add('is-active'));

        applyFilters();
      });
    });
  }
</script>
