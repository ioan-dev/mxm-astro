<div class="preloader"></div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 100;
    background-color: var(--color-bg-primary);
  }
</style>

<script>
  import { gsap } from 'gsap';

  function preloader() {
    gsap.to('.preloader', { autoAlpha: 0 });
  }

  document.addEventListener('DOMContentLoaded', preloader);
</script>
