<style>
  .preloader {
    --flow-space: var(--spacing-4);

    position: fixed;
    inset: 0;
    z-index: 100;
    background-color: var(--color-bg-primary);
    padding: var(--spacing-4);
  }

  :is(.counter, .preloader__inner) {
    visibility: hidden;
  }

  .preloader__logo-wrapper {
    position: relative;
  }

  :is(.mxm, .max, .mikhailov, .architecture) {
    svg {
      color: var(--color-bg-primary-inverse);
      width: auto;
      height: 117px;
      display: block;
      overflow: hidden;
    }
  }

  .max {
    position: absolute;
    left: 0;
    top: 0;
  }

  .mikhailov {
    display: flex;
    column-gap: 9px;
  }

  .mxm {
    display: flex;
  }

  .counter {
    position: fixed;
    bottom: var(--spacing-4);
    right: var(--spacing-4);
    overflow: hidden;
  }

  .counter__inner {
    display: flex;
  }

  /* Responsive */

  @media (--tablet-above) {
    .preloader__inner-mobile {
      display: none;
    }
  }

  @media (--tablet) {
    :is(.counter, .preloader__inner) {
      display: none;
    }

    .preloader__inner-mobile {
      display: grid;
      grid-template-rows: repeat(3, 1fr);
      height: 100%;
    }

    .preloader__logo-mobile {
      color: var(--color-text-primary);
      align-self: end;

      & svg {
        width: 100%;
        height: auto;
      }
    }

    .counter-mobile {
      justify-self: center;
      align-self: center;
    }

    .counter-mobile__inner {
      display: flex;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { Flip } from 'gsap/Flip';

  function preloader() {
    // gsap.to('.preloader', { autoAlpha: 0 });

    gsap.registerPlugin(Flip);

    let mm = gsap.matchMedia();

    let loader = document.querySelector('.preloader');

    mm.add({ isLarge: '(min-width: 1024px)', isSmall: '(max-width: 1023px)' }, (context) => {
      let { isLarge, isSmall } = context.conditions;

      if (isLarge) {
        let letterArhitecture = gsap.utils.toArray('.architecture path');
        let letterMikhailov = gsap.utils.toArray('.mikhailov path').reverse();
        let letterMikhailovNotM = gsap.utils
          .toArray('.mikhailov svg:not(.letterMove) path')
          .reverse();
        let letterLogo = gsap.utils.toArray('.mxm .letter');
        let letterMax = gsap.utils.toArray('.max path');
        let letterAinMax = letterMax[1];
        let letterXinMax = letterMax[0];
        let letterXinMxm = letterLogo[1];
        let letterMove = document.querySelector('.letterMove');

        // COUNTER
        let counterWrapper = document.querySelector('.counter__inner');
        let counterElement = document.querySelector('.counter__numbers');

        gsap.set([letterArhitecture, letterMikhailov, letterMax, letterLogo, counterWrapper], {
          yPercent: 102,
        });

        // --- MASTER ---

        let valueFrom = 102;
        let valueTo = -102;

        let charsDuration = 1;
        let yMovePercent = 102;
        let charsStagger = 0.1;

        let tlMaster = gsap.timeline({
          onComplete: () => {
            window.dispatchEvent(new CustomEvent('preloader:complete'));
          },
        });

        tlMaster
          .to(['.preloader__inner-mobile', '.counter'], { autoAlpha: 1, duration: 0.1 })
          .add('start', '0.3')
          .add(tlLetter(letterArhitecture), 'start')
          .add(tlLetter(letterMax), 'start')
          .add(tlLetter(letterMikhailov), '<')
          .to(counterWrapper, { yPercent: 0 }, 'start')
          .call(counter, null, 'start+=0.5')
          .add('timerEnd', '4')
          .to(counterWrapper, { yPercent: valueTo }, 'timerEnd')
          .to(letterXinMax, { yPercent: valueTo, duration: 0.4 }, 'timerEnd')
          .to(letterAinMax, { yPercent: valueTo, duration: 0.4 }, '-=98%')
          .to(letterXinMxm, { yPercent: 0, duration: 0.6, ease: 'power2.out' }, '<+=20%')
          .add(tlLetter(letterMikhailovNotM, valueTo, false), '<')
          .add(tlLetter(letterArhitecture, valueTo, false), '<+=5%')
          .call(flip, null, '<')
          .to('.preloader', { autoAlpha: 0, duration: 0.1 }, '5');

        function tlLetter(letters: any, value = 0, direction = true, dur = 0.5, stag = 0.02) {
          let tl = gsap.timeline();

          if (direction) {
            tl.to(letters, {
              yPercent: value,
              duration: dur,
              stagger: -stag,
            });
          } else {
            tl.to(letters, {
              yPercent: value,
              duration: dur,
              stagger: stag,
            });
          }
          return tl;
        }

        function flip() {
          let logoWrapper = document.querySelector('.mxm');
          let state = Flip.getState(letterMove);
          logoWrapper.append(letterMove);
          Flip.from(state, { duration: 0.9, ease: 'power2.inOut' });
        }

        function counter(dur = 3.5) {
          gsap.to(counterElement, {
            duration: dur,
            innerHTML: 100,
            roundProps: 'innerHTML',
            ease: 'power2.out',
            onUpdate: function () {
              // Обновляем текст в элементе при каждом шаге анимации
              counterElement.textContent = Math.round(counterElement.innerHTML);
            },
          });
        }
      }

      if (isSmall) {
        // COUNTER
        let counterWrapper = document.querySelector('.counter-mobile__inner');
        let counterElement = document.querySelector('.counter-mobile__numbers');

        let tlMaster = gsap.timeline({
          onComplete: () => {
            window.dispatchEvent(new CustomEvent('preloader:complete'));
          },
        });

        tlMaster
          .to(['.preloader__inner', '.counter'], { autoAlpha: 1, duration: 0.1 })
          .add('start', '0.3')
          .to(counterWrapper, { yPercent: 0 }, 'start')
          .call(counter, null, 'start+=0.5')
          .to(
            loader,
            {
              yPercent: -101,
              duration: 0.5,
              ease: 'power1.in',
            },
            'start+=3'
          );

        function counter(dur = 3.5) {
          gsap.to(counterElement, {
            duration: dur,
            innerHTML: 100,
            roundProps: 'innerHTML',
            ease: 'power2.out',
            onUpdate: function () {
              // Обновляем текст в элементе при каждом шаге анимации
              counterElement.textContent = Math.round(counterElement.innerHTML);
            },
          });
        }
      }
    });
  }

  document.addEventListener('DOMContentLoaded', preloader);
</script>
