---
import { links } from '../lib/queries/nav-links';
import { safeJsonDebug } from '../utils/jsonHelpers';
import ButtonLink from './Button-link.astro';
import LogoHome from './LogoHome.astro';
import { Icon } from 'astro-icon/components';
---

<header class="header">
  <!-- <pre>
  {safeJsonDebug(links)}
</pre> -->
  <div class="grid">
    <div class="header__logo">
      <LogoHome />
    </div>
    <nav>
      <ul class="header__nav" role="list">
        {
          links.map((item) => {
            return (
              <li>
                <a class="header__nav-link label-small" href={item.slug}>
                  {item.name}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="header__buttons">
      <ButtonLink iconLeft="light-theme" data-theme>
        <span class="light">Светлая тема</span> <span class="dark">Темная тема</span></ButtonLink
      >
      <ButtonLink iconRight="move-right-link" data-header="modal">Связаться</ButtonLink>
    </div>
    <div class="header__burger">
      <Icon name="menu" />
    </div>
    <div class="header__close">
      <Icon name="close" />
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0px;
    left: 0px;
    z-index: 90;
    width: 100%;
    padding: var(--spacing-4);
    pointer-events: none;
    background: linear-gradient(180deg, rgb(13, 13, 13), rgba(13, 13, 13, 0) 100%);

    & .grid {
      align-items: start;
    }

    nav {
      grid-column: 5 / 9;

      ul {
        display: flex;
        align-items: start;
        gap: var(--spacing-2);
        list-style: none;
        margin: 0;
        padding: 0;
      }

      li {
        display: flex;
      }
    }
  }

  .header__buttons {
    grid-column: 9 / -1;
    display: flex;
    justify-content: space-between;
    row-gap: var(--spacing-4);
  }

  & :is(.button-link, .header__nav-link, .header__burger, .header__close) {
    pointer-events: auto;
  }

  .header__logo {
    grid-column: span 4;
  }

  .header__burger-hide {
    opacity: 0;
    visibility: hidden;
  }

  /* Кнопка всегда показывает СЛЕДУЮЩУЮ тему */
  .dark {
    display: none;
  }
  .light {
    display: inline;
  }

  /* Когда сейчас светлая — следующая будет тёмная */
  :root[data-theme='light'] .light {
    display: none;
  }
  :root[data-theme='light'] .dark {
    display: inline;
  }

  /* Responsive */

  @media (--tablet-above) {
    .header__burger,
    .header__close {
      display: none;
    }
  }

  @media (--tablet) {
    .header__logo {
      grid-column: span 2;
    }
    nav {
      display: none;
    }
    .header__buttons {
      display: none;
    }

    .header__burger,
    .header__close {
      --icon-size: var(--icon-size-large);
      position: absolute;
      top: var(--spacing-4);
      right: var(--spacing-4);
    }

    .header__close {
      opacity: 0;
      visibility: hidden;
    }

    .header__close--show {
      opacity: 1;
      visibility: visible;
    }
  }
</style>

<script>
  const btn = document.querySelector('[data-theme]');

  btn.addEventListener('click', () => {
    const isLight = document.documentElement.dataset.theme === 'light';
    document.documentElement.dataset.theme = isLight ? 'dark' : 'light';
  });
</script>
