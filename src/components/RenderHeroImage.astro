---
import { Image } from "@unpic/astro";
const { imageData, ASSETS_URL } = Astro.props;
const img = imageData?.item;

if (!img?.image) {
  return null;
}
---

<div
  class:list={["hero-scroll__image-wrapper", img.inverse && "inverse"]}
  data-hero-image="down"
>
  <Image
    alt=""
    layout="fullWidth"
    src={`${ASSETS_URL}/${img.image}`}
    cdn="directus"
  />
</div>

<style>
  .hero-scroll__image-wrapper {
    height: 100%;
    width: 100%;
    position: absolute;
    left: 0;
    top: 0;

    /* &[data-hero-image="down"] {
      translate: 0% 101%;
    } */

    &.inverse::before {
      content: "";
      position: absolute;
      inset: 0;
      background-color: #ffffff;
      z-index: 10;
      mix-blend-mode: difference;
    }
  }
</style>
