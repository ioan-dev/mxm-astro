---
import { safeJsonDebug } from '../utils/jsonHelpers';
import { ASSETS_URL } from '../lib/constants';
import { Image } from '@unpic/astro';
import Button from './Button.astro';

const { editor, images, button_for_section } = Astro.props.item || {};
const { label, type, page, url } = button_for_section;
const btnHref =
  type === 'page' ? (page?.slug ?? undefined) : type === 'url' ? (url ?? undefined) : undefined;

// Открываем в новой вкладке только для внешних ссылок
const btnTarget = type === 'url' ? '_blank' : undefined;
// rel нужен по безопасности, когда есть target="_blank"
const btnRel = type === 'url' ? 'noopener noreferrer' : undefined;
---

