<style>
  .about {
    /* margin-top: -70px; */
  }

  .about__headline-wrapper {
    grid-column: span 8;
  }

  .about__headline {
    display: flex;
    align-items: flex-end;
    column-gap: 50px;
  }

  .about__body {
    grid-column: 10 / span 3;

    display: flex;
    flex-direction: column;

    padding-top: 23px;

    row-gap: var(--spacing-l);
  }

  .about__word-wrapper {
    display: flex;
    flex-direction: column;
    row-gap: 8px;
  }

  .about__mind {
    flex: none;
    height: 94px;
  }

  .about__matter {
    flex: none;
    height: 94px;
  }

  .about__icon {
    width: 94px;
    height: 94px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
</style>
