</section>

<style>
  .about {
    --flow-space: var(--spacing-0);
  }
  .about__content {
    margin-top: -70px;
  }

  .about__headline-wrapper {
    grid-column: span 8;
  }

  .about__headline {
    display: flex;
    align-items: flex-end;
    column-gap: 50px;
  }

  .about__image-item {
    grid-column: span 4;
  }

  .about__body {
    grid-column: 10 / span 3;

    display: flex;
    flex-direction: column;

    padding-top: 23px;

    row-gap: var(--spacing-8);
  }

  .about__text {
    --flow-space: var(--spacing-4);
  }

  .about__word-wrapper {
    display: flex;
    flex-direction: column;
    row-gap: 8px;
  }

  .about__mind {
    flex: none;
    height: 94px;
  }

  .about__matter {
    flex: none;
    height: 94px;
  }

  .about__icon {
    width: 94px;
    height: 94px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .about__mind,
  .about__icon,
  .about__matter {
    & svg {
      width: 100%;
      height: 100%;
    }
  }

  /* Responsive */

  @media (--tablet-above) {
    .about__headline-mobile {
      display: none;
    }

    .about__mobile-btn {
      display: none;
    }
  }

  @media (--tablet) {
    .about {
      padding-top: 32px;
    }
    .about__content {
      margin-top: 0px;
    }

    .about__images {
      display: none;
    }

    .about__time {
      display: none;
    }
    .about__headline-wrapper {
      grid-column: span 4;
    }

    .about__headline-mobile {
      svg {
        width: 100%;
        height: auto;
      }
    }

    .about__headline {
      display: none;
    }

    .about__word-wrapper {
      display: none;
    }
    .about__body {
      grid-column: span 4;
      max-width: 214px;
      padding-top: 32px;
    }

    .about__footer {
      display: none;
    }

    .about__mobile-btn {
      grid-column: span 4;
      padding-top: var(--spacing-8);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';

  function aboutSplit() {
    let subHeaders = document.querySelectorAll('[data-split="about-subheader"]');
    // let title = document.querySelector('[data-animation="hero-title"]')

    return document.fonts.ready.then(() => {
      // const splitTitle = SplitText.create(title, {
      //   type: 'chars, words, lines',
      //   charsClass: 'char',
      //   mask: "lines"
      // });

      const splitSubheader = SplitText.create(subHeaders, {
        type: 'words, chars',
        charsClass: 'char',
        wordsClass: 'word',
        mask: 'words',
      });

      // Возвращаем ОБЪЕКТ с двумя split-ами
      return {
        // title: splitTitle,
        subheader: splitSubheader,
      };
    });
  }
  async function aboutAnimation() {
    let subText = document.querySelectorAll('[data-split="about-subheader"]');
    let split = await aboutSplit();

    // Нужно собрать все элементы подписи about
    let mindLetter = gsap.utils.toArray('[data-about="mind-letter"]');
    let xFigure = gsap.utils.toArray('[data-about="x-figure"]');
    let matterLetter = gsap.utils.toArray('[data-about="matter-letter"]');

    gsap.set(split?.subheader.masks, { y: '-20vw' });
    gsap.set(split?.subheader.chars, { yPercent: 102 });

    gsap.set([mindLetter, xFigure, matterLetter], { yPercent: 101 });

    let tlLetter = gsap.timeline({
      scrollTrigger: {
        trigger: split.subheader.words,
        start: 'top 60%',
        // markers: true,
      },
    });

    tlLetter.to(split?.subheader.chars, { yPercent: 0, stagger: 0.01 });

    let tlWordsMove = gsap.timeline({
      scrollTrigger: {
        trigger: split.subheader.masks,
        start: 'top 40%',
        end: 'bottom -20%',
        // markers: true,
        scrub: 0.8,
        once: true,
      },
    });

    tlWordsMove
      .to(split?.subheader.masks, { y: 0, duration: 2, stagger: 0.1 })
      .to(mindLetter, { yPercent: 0, stagger: -0.01, duration: 2 }, '<')
      .to(xFigure, { yPercent: 0, duration: 2 }, '<+=0.2')
      .to(matterLetter, { yPercent: 0, stagger: -0.01, duration: 2 }, '<+=0.2');
  }

  aboutAnimation();

  // --- Часы ---

  // Находим элемент по атрибуту data-js-time
  const timeEl = document.querySelector('[data-js-time]');

  // Функция форматирует число в двузначный вид: 9 → "09"
  function pad(n) {
    return String(n).padStart(2, '0');
  }

  // Функция обновляет текст элемента текущим временем
  function updateTime() {
    const now = new Date();
    const h = pad(now.getHours());
    const m = pad(now.getMinutes());
    const s = pad(now.getSeconds());
    timeEl.textContent = `${h}:${m}`;
  }

  // Запускаем сразу, чтобы не было задержки в 1 секунду при загрузке
  updateTime();

  // Обновляем каждую секунду
  setInterval(updateTime, 60000);
</script>
