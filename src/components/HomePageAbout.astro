  <div class="about__inner wrapper">
    <div class="about__images grid">
      {
        images.map((wrapper: any) => {
          const imgData = wrapper.item;

          return (
            <div class="about__image-item">
              <div class:list={['hero-scroll__image-wrapper']}>
                <div class="frame" data-frame-type="vh">
                  <Image
                    alt=""
                    layout="fullWidth"
                    src={`${ASSETS_URL}/${imgData.image}`}
                    cdn="directus"
                  />
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
    <div class="about__content grid">
      <div class="about__headline-wrapper">
        <div class="about__headline">
          <div class="about__word-wrapper">
            <p class="text-small text-uppercase" data-split="about-subheader">
              Where thoughts become
