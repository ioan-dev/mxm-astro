---
import { safeJsonDebug } from '../../utils/jsonHelpers';
import { ASSETS_URL } from '../../lib/constants';
import RenderHeroImage from '../RenderHeroImage.astro';
import { Image } from '@unpic/astro';
import { render } from 'astro:content';

// Получаем данные блока hero
const {
  headline = '',
  images_wrapper = [],
  images_wrapper_2 = [],
  images_mobile = [],
} = Astro.props.item || {};
---

<div class="hero">
  <div class="hero-scroll">
    <div class="hero-scroll__inner grid">
      <div class="hero-scroll__item">
        <h1 class="hero-scroll__heading heading-medium">
          {headline}
        </h1>
      </div>

      <div class="hero-scroll__item">
        {
          images_wrapper.map((wrapper: any, index: number) => (
            <RenderHeroImage imageData={wrapper} ASSETS_URL={ASSETS_URL} index={index} />
          ))
        }
      </div>

      <div class="hero-scroll__item">
        {
          images_wrapper_2.map((wrapper: any, index: number) => (
            <RenderHeroImage imageData={wrapper} ASSETS_URL={ASSETS_URL} index={index} />
          ))
        }
      </div>
    </div>
    <div class="hero-scroll__spacer"></div>
  </div>

  <div class="hero-mobile">
    <div class="hero-mobile__inner container">
      <h1 class="hero-mobile__title heading-large">{headline}</h1>
      <div class="hero-mobile__footer">
        <p class="hero-mobile__text">WHERE THOUGHTS BECOME</p>
        <p class="hero-mobile__text">SPACE</p>
      </div>
    </div>
    <div class="hero-mobile__slider">
      <div class="swiper hero-mobile__swiper">
        <div class="swiper-wrapper">
          {
            images_mobile.map((slide: any) => {
              return (
                <div class="swiper-slide">
                  <div class="frame">
                    <Image
                      alt=""
                      layout="fullWidth"
                      src={`${ASSETS_URL}/${slide.directus_files_id.id}`}
                      cdn="directus"
                    />
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-scroll {
    padding-inline: var(--spacing-4);
    position: relative;
  }

  .hero-scroll__spacer {
    height: 100vh;
  }

  .hero-scroll__inner {
    --height-value: 54px;

    padding-top: var(--height-value);
    height: 100vh;

    position: sticky;
    top: 0;
  }

  .hero-scroll__heading {
    max-width: 370px;
  }

  .hero-scroll__item {
    grid-column: span 4;

    &:has(img) {
      position: relative;
      overflow: hidden;
    }

    &:first-child {
      padding-bottom: var(--spacing-8);
      align-self: end;
    }

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  @media (--tablet-above) {
    .hero-mobile {
      display: none;
    }
  }

  /* Responsive */
  @media (--tablet) {
    .hero-scroll {
      display: none;
    }

    .hero-mobile {
      position: relative;
      display: block;
      height: 100svh;
      padding-block: 16px;

      &::before {
        content: '';
        position: absolute;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.3);
      }
    }

    .hero-mobile__swiper {
      width: 100%;
      height: 100%;
    }

    .hero-mobile__inner {
      height: 100%;
      position: relative;
      display: flex;
      flex-direction: column;
      padding-inline: var(--spacing-4);
    }

    .hero-mobile__title {
      margin-top: auto;
      margin-bottom: auto;

      max-width: 368px;
    }

    .hero-mobile__footer {
      display: flex;
      justify-content: space-between;
      position: absolute;
      width: 100%;
      padding-inline: 16px;
      left: 0;
      bottom: 0;
    }

    .hero-mobile__slider {
      height: 100%;
      position: absolute;
      inset: 0;
      z-index: -1;

      &:before {
        content: '';
        position: absolute;
        inset: 0;
        background: #000;
        opacity: 0.5;
      }

      .frame {
        height: 100%;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }
    }
  }

  /* .hero-scroll__spacer {
    height: 200vh;
  } */
</style>

<script>
  import Swiper from 'swiper/bundle';
  import 'swiper/css';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function scrollingAnimation() {
    let mm = gsap.matchMedia();

    mm.add({ isLarge: '(min-width: 1024px)', isSmall: '(max-width: 1023px)' }, (context) => {
      let { isLarge, isSmall } = context.conditions || {};

      if (isLarge) {
        let tlHero = gsap.timeline({
          scrollTrigger: {
            trigger: '.hero-scroll',
            start: 'top top',
            end: 'bottom bottom',
          },
        });

        // -------- tlMoveImage Start--------

        let tlMoveImage = gsap.timeline({
          scrollTrigger: {
            trigger: '.hero-scroll',
            id: 'image',
            start: 'top top',
            end: '40%',
            scrub: true,
          },
        });

        let imagesUp = document.querySelectorAll('[data-hero-image="up"]');
        let imagesDown = document.querySelectorAll('[data-hero-image="down"]');
        const wasShown = localStorage.getItem('preloader-shown');

        // Скрываем imagesDown всегда (они анимируются скроллом, не прелоадером)
        gsap.set(imagesDown, { yPercent: 102 });

        // imagesUp скрываем только если будет анимация
        if (wasShown) {
          gsap.set(imagesUp, { yPercent: 102 });
        }

        let images = document.querySelectorAll('.hero-scroll .hero-scroll__image-wrapper');

        let tlImageUp = gsap.timeline();

        window.addEventListener('preloader:complete', () => {
          if (wasShown) {
            tlImageUp.to(imagesUp, {
              yPercent: 0,
              stagger: 0.2,
              duration: 0.9,
              ease: 'power1.out',
            });
          }
          // else ветка не нужна — imagesUp уже в yPercent: 0
        });

        tlMoveImage.to(images, {
          yPercent: 0,
          stagger: 0.2,
          duration: 0.9,
          ease: 'power1.out',
        });
        // -------- tlMoveImage End --------

        let logo = document.querySelector('.logo');
        let logoText = document.querySelector('.logo__text');

        let tlLogoScale = gsap.timeline({
          scrollTrigger: {
            trigger: '.hero-scroll',
            start: 'top top',
            end: '40%',
            scrub: true,
          },
        });

        tlLogoScale
          .to(logo, { scale: 0.4, duration: 1, transformOrigin: 'top left' })
          .to(logoText, { autoAlpha: 0 }, '<');
      }
    });
  }

  scrollingAnimation();

  heroSlider();

  function heroSlider() {
    let swiper = new Swiper('.hero-mobile__swiper', {
      direction: 'vertical',
      autoplay: false,
      speed: 800,
      loop: true,
      allowTouchMove: false,
    });

    return swiper;
  }
</script>
