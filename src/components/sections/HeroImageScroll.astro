---
import { safeJsonDebug } from '../../utils/jsonHelpers';
import { ASSETS_URL } from '../../lib/constants';
import RenderHeroImage from '../RenderHeroImage.astro';

// Получаем данные блока hero
const { headline = '', images_wrapper = [], images_wrapper_2 = [] } = Astro.props.item || {};
---

<section class="hero-scroll">
  <div class="hero-scroll__inner grid">
    <div class="hero-scroll__item">
      <h1 class="hero-scroll__heading heading-medium">
        {headline}
      </h1>
    </div>

    <div class="hero-scroll__item">
      {
        images_wrapper.map((wrapper: any) => (
          <RenderHeroImage imageData={wrapper} ASSETS_URL={ASSETS_URL} />
        ))
      }
    </div>

    <div class="hero-scroll__item">
      {
        images_wrapper_2.map((wrapper: any) => (
          <RenderHeroImage imageData={wrapper} ASSETS_URL={ASSETS_URL} />
        ))
      }
    </div>
  </div>
  <div class="hero-scroll__spacer"></div>
</section>

<style>
  .hero-scroll {
    padding-inline: var(--spacing-4);
    position: relative;
  }

  .hero-scroll__inner {
    --height-value: 54px;

    padding-top: var(--height-value);
    height: 100vh;

    /* position: sticky;
    top: 0; */
  }

  .hero-scroll__heading {
    max-width: 370px;
  }

  .hero-scroll__item {
    grid-column: span 4;

    &:has(img) {
      position: relative;
      overflow: hidden;
    }

    &:first-child {
      padding-bottom: var(--spacing-8);
      align-self: end;
    }

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  /* .hero-scroll__spacer {
    height: 200vh;
  } */
</style>

