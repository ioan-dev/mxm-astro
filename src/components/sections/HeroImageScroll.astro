---
import { Picture } from "astro:assets";
import { Image } from "astro:assets";

// Получаем данные блока hero
const {
  headline = "",
  images_wrapper = [],
  images_wrapper_2 = [],
  images_wrapper_3 = [],
} = Astro.props.item || {};
const astroPr = Astro.props;

const directusUrl = "https://cms.max-mikhailov.com";

// Функция-помощник, чтобы легко создавать ссылку на любое изображение из Directus
function getDirectusImageUrl(
  fileId: string,
  width?: number,
  height?: number,
): string {
  let url = `${directusUrl}/assets/${fileId}`;

  // Добавляем параметры трансформации (опционально)
  const params = [];
  if (width) params.push(`width=${width}`);
  if (height) params.push(`height=${height}`);
  // Можно добавить: format=webp, quality=80, fit=cover и т.д.

  if (params.length > 0) {
    url += "?" + params.join("&");
  }

  return url;
}
---

<div>
  <pre>{JSON.stringify(astroPr.item, null, 2)}</pre>
</div>
<section class="hero-scroll">
  <div class="hero-scroll__inner grid">
    <div class="hero-scroll__item">
      <h1 class="hero-scroll__heading heading-medium">
        {headline}
      </h1>
    </div>

    <div class="hero-scroll__item">
      {
        images_wrapper.map((wrapper: any) => {
          const img = wrapper.item; // вот здесь настоящий объект с картинкой
          if (!img?.media) return null;

          return (
            <div
              class:list={[
                "hero-scroll__image-wrapper",
                img.inverse && "inverse",
              ]}
              data-hero-image="down"
            >
              <img
                src={getDirectusImageUrl(img.media, 1200)}
                alt="Архитектурное фото"
                loading="lazy"
              />
            </div>
          );
        })
      }
    </div>

    <div class="hero-scroll__item">
      <Image
        alt={""}
        width={"490"}
        height={"700"}
        format="avif"
        src={"https://cms.max-mikhailov.com/assets/fc498dbf-0e5f-46cb-83bc-a88ae94c974a?width=490&height=700"}
      />

      {
        images_wrapper.map((wrapper: any) => {
          const img = wrapper.item; // вот здесь настоящий объект с картинкой
          if (!img?.media) return null;

          // return (
          //   <div
          //     class:list={[
          //       "hero-scroll__image-wrapper",
          //       img.inverse && "inverse",
          //     ]}
          //     data-hero-image="down"
          //   >
          //     <img
          //       src={getDirectusImageUrl(img.media, 1200)}
          //       alt="Архитектурное фото"
          //       loading="lazy"
          //     />
          //   </div>
          // );
        })
      }
    </div>
  </div>
  <div class="hero-scroll__spacer"></div>
</section>

<style>
  .hero-scroll {
    padding-inline: var(--spacing-4);
    position: relative;
  }

  .hero-scroll__inner {
    --height-value: 54px;

    padding-top: var(--height-value);
    height: 100vh;

    position: sticky;
    top: 0;
  }

  .hero-scroll__heading {
    max-width: 370px;
  }

  .hero-scroll__item {
    grid-column: span 4;

    &:has(img) {
      position: relative;
      overflow: hidden;
    }

    &:first-child {
      padding-bottom: var(--spacing-8);
      align-self: end;
    }
  }

  .hero-scroll__image-wrapper {
    height: 100%;
    width: 100%;
    position: absolute;
    left: 0;
    top: 0;

    /* &[data-hero-image="down"] {
      translate: 0% 101%;
    } */

    &.inverse::before {
      content: "";
      position: absolute;
      inset: 0;
      background-color: #ffffff;
      z-index: 10;
      mix-blend-mode: difference;
    }

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .hero-scroll__spacer {
    height: 200vh;
  }
</style>

