---
import { Image } from "astro:assets";

const { headline = "" } = Astro.props.item as { headline?: string };
const astroPr = Astro.props;

const directusUrl = "https://cms.max-mikhailov.com";

const imageId = "aa3c8b46-a06f-451c-ada3-7cf7231d799e";

const imageSrc = `${directusUrl}/assets/${imageId}`;
---

<!-- <div>
  <pre>{JSON.stringify(astroPr.item, null, 2)}</pre>
</div> -->
<section class="hero-scroll">
  <div class="hero-scroll__inner grid">
    <div class="hero-scroll__item">
      <h1 class="hero-scroll__heading heading-medium">
        {headline}
      </h1>
    </div>
    <div class="hero-scroll__item">
      <div class="hero-scroll__image-wrapper">
        <img src={imageSrc} alt="" />
      </div>
    </div>
    <div class="hero-scroll__item">
      <div class="hero-scroll__image-wrapper">
        <img src="" alt="" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-scroll {
    --height-value: 54px;

    padding-top: var(--height-value);
    padding-inline: var(--spacing-4);
    height: 100vh;
  }

  .hero-scroll__inner {
    height: 100%;
  }

  .hero-scroll__heading {
    max-width: 370px;
  }

  .hero-scroll__item {
    grid-column: span 4;

    &:first-child {
      padding-bottom: var(--spacing-8);
      align-self: end;
    }
  }

  .hero-scroll__image-wrapper {
    height: 100%;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
