<div class="logo flow">
  <a href="/" class="logo__link">
    <svg viewBox="0 0 370 117" xmlns="http://www.w3.org/2000/svg">
      <path
        d="M62.6973 78.6016H64.0312L96.2822 0H126.885V117H102.716V40.832H101.774L71.4072 116.45H55.085L24.9531 40.6748H24.0117V117H0V0H30.5244L62.6973 78.6016ZM223.706 117H213.757L152.873 0.0605469H162.822L223.706 117ZM305.812 78.6016H307.146L339.396 0H370V117H345.831V40.832H344.89L314.521 116.45H298.2L268.068 40.6748H267.127V117H243.115V0H273.64L305.812 78.6016ZM183.092 67.25L138.691 116.999H126.885L178.742 58.8955L183.092 67.25ZM195.657 53.1719L191.307 44.8174L231.309 0H243.115L195.657 53.1719Z"
        fill="currentColor"></path>
    </svg>
  </a>

  <p class="logo__text text-color-secondary text-small">Max Mikhailov Architecture</p>
</div>

<style>
  .logo {
    --flow-space: var(--spacing-2);
    display: block;

    svg {
      width: auto;
      height: 117px;
    }
  }

  .logo__link {
    pointer-events: auto;
    color: var(--color-text-primary);
  }

  /* Responsive */
  @media (--tablet) {
    .logo {
      svg {
        height: 23px;
      }
    }
    .logo__text {
      display: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(SplitText);

  // Ждём загрузки всех шрифтов, и только потом запускаем SplitText
  document.fonts.ready.then(() => {
    let text = document.querySelector('.logo__text');

    if (text) {
      const splitText = SplitText.create(text, {
        type: 'chars, lines',
        charsClass: 'char',
        linesClass: 'lineParent',
        mask: 'lines',
      });

      gsap.set(splitText.chars, { yPercent: 102 });

      window.addEventListener('preloader:complete', () => {
        gsap.to(splitText.chars, { yPercent: 0, stagger: 0.009, duration: 0.25 });
      });
    }
  });
</script>
