---
import { ASSETS_URL } from '../lib/constants';
import { Image } from '@unpic/astro';
import Button from './Button.astro';
const { headline = '', list, button } = Astro.props.item || [];

let btn = button;
const { label, type, page } = btn;
const btnHref = type === 'page' && page?.slug ? page.slug : undefined;
---

<!--  TEAM-->
<section class="team">
  <div class="wrapper">
    <div class="team__inner flow">
      <h2 class="heading-medium">{headline}</h2>
      <div class="team__grid grid">
        <div class="team__show-wrapper">
          {
            list.map((el: any, index: number) => {
              if (el.type === 'Сотрудник') {
                return (
                  <div class={`team__show ${index === 0 ? 'team__show--active' : ''}`}>
                    <div class="frame" data-frame-type="square">
                      <div class="team__show-image">
                        <img src={`${ASSETS_URL}/${el.photo}`} alt={el.name} />
                      </div>
                    </div>
                    <div class="team__show-footer text-small line-height-small">
                      <span class="team__show-name">{el.name}</span>
                      <span class="team__show-post text-color-secondary">{el.position}</span>
                    </div>
                  </div>
                );
              }
            })
          }
        </div>
        <div class="team__miniatures-wrapper">
          <div class="team__miniatures">
            {
              list.map((el: any, index: number) => {
                if (el.type === 'Сотрудник') {
                  return (
                    <div class="team__item" data-team-name={el.name} data-team-post={el.position}>
                      <div class="frame" data-frame-type="square">
                        <Image
                          alt=""
                          layout="fullWidth"
                          aspectRatio={1 / 1}
                          sizes="(max-width: 720px) 100vw, 50vw"
                          breakpoints={[320, 720, 1440]}
                          src={`${ASSETS_URL}/${el.photo}`}
                          cdn="directus"
                        />
                      </div>
                    </div>
                  );
                }
              })
            }
          </div>
          <div class="team__button-wrapper">
            {
              btnHref ? (
                <Button href={btnHref} size="medium">
                  {label}
                </Button>
              ) : (
                <Button size="medium">{label}</Button>
              )
            }
          </div>
        </div>
      </div>
      <div class="team__slider-mobile">
        <div class="swiper team__slider-main">
          <!-- Additional required wrapper -->
          <div class="swiper-wrapper">
            <!-- Slides -->

            {
              list.map((el: any, index: number) => {
                if (el.type === 'Сотрудник') {
                  return (
                    <div class="swiper-slide">
                      <div class="team__slider-card">
                        <div class="team__slider-image">
                          <div class="frame" data-frame-type="square">
                            <Image
                              alt=""
                              layout="fullWidth"
                              aspectRatio={1 / 1}
                              sizes="(max-width: 720px) 100vw, 50vw"
                              breakpoints={[320]}
                              src={`${ASSETS_URL}/${el.photo}`}
                              cdn="directus"
                            />
                          </div>
                        </div>
                        <div class="team__slider-text-wrapper">
                          <p class="text-small line-height-large">{el.name}</p>
                          <p class="text-small line-height-large text-color-secondary">
                            {el.position}
                          </p>
                        </div>
                      </div>
                    </div>
                  );
                }
              })
            }
          </div>
        </div>

        {
          btnHref ? (
            <Button href={btnHref} size="medium">
              {label}
            </Button>
          ) : (
            <Button size="medium">{label}</Button>
          )
        }
      </div>
      <div class="team__slider-buttons">
        <button class="team__slider-prev-btn">
          <svg
            width="100%"
            height="100%"
            viewBox="0 0 34 34"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M21.0016 28.5002L10 17.0002L21.0016 5.50024L24 8.63441L15.8353 17.0002L24 25.3661L21.0016 28.5002Z"
              fill="#FBFBFB"></path>
          </svg>
        </button>

        <button class="team__slider-next-btn">
          <svg
            width="100%"
            height="100%"
            viewBox="0 0 34 34"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M12.9984 28.5L10 25.3658L18.1647 17L10 8.63417L12.9984 5.5L24 17L12.9984 28.5Z"
              fill="#FBFBFB"></path>
          </svg>
        </button>
      </div>
      <div class="team__slider-miniatures">
        <div class="swiper">
          <!-- Additional required wrapper -->
          <div class="swiper-wrapper">
            <!-- Slides -->

            {
              list.map((el: any, index: number) => {
                if (el.type === 'Сотрудник') {
                  return (
                    <div class="swiper-slide">
                      <div class="team__slider-miniatures-card">
                        <div class="frame" data-frame-type="square">
                          <Image
                            alt=""
                            layout="fullWidth"
                            aspectRatio={1 / 1}
                            sizes="(max-width: 720px) 100vw, 50vw"
                            breakpoints={[320]}
                            src={`${ASSETS_URL}/${el.photo}`}
                            cdn="directus"
                          />
                        </div>
                      </div>
                    </div>
                  );
                }
              })
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .team__inner {
    --flow-space: var(--spacing-8);
  }
  .team__show-wrapper {
    position: relative;
    min-height: 520px;
    grid-column: 1 / span 4;
  }

  .team__show {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    display: flex;
    flex-direction: column;
    row-gap: var(--spacing-2);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .team__show--active {
    opacity: 1;
  }

  .team__show-footer {
    position: relative;
    display: flex;
    justify-content: space-between;
    overflow: hidden;
  }

  .team__miniatures-wrapper {
    grid-column: 5 / span 8;
    display: flex;
    flex-direction: column;
    row-gap: var(--spacing-8);
  }

  .team__miniatures {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    align-content: start;
  }

  .team__item {
    position: relative;
    cursor: pointer;

    &::before {
      position: absolute;
      content: '';
      z-index: 10;
      background-color: var(--color-bg-primary);
      opacity: 0.5;
      inset: 0px;
      transition: opacity 0.3s;
    }
  }

  .team__item--active {
    &::before {
      opacity: 0;
    }
  }

  .team__button-wrapper {
    display: flex;
    justify-content: flex-end;
  }

  /* Responsive */

  @media (--tablet-above) {
    .team__slider-mobile,
    .team__slider-buttons,
    .team__slider-miniatures {
      display: none;
    }
  }

  @media (--tablet) {
    .team {
      position: relative;
    }

    :is(.team__miniatures, .team__show-wrapper, .team__miniatures-wrapper) {
      display: none;
    }

    .team__inner {
      --flow-space: var(--spacing-2);
    }

    .team__slider-mobile {
      position: relative;
      display: flex;
      flex-direction: column;
      row-gap: 24px;

      .frame {
        width: 368px;
        height: 368px;

        img {
          height: 100%;
          object-fit: cover;
        }
      }
    }

    .team__slider-main {
      max-width: 368px;
      background: var(--color-bg-primary);
    }

    .team__slider-card {
      display: flex;
      flex-direction: column;
      row-gap: 4px;
    }

    .team__slider-miniatures {
      position: absolute;
      width: 100%;
      left: 0;
      top: 43%;
      z-index: -1;
      transform: translateY(-50%);

      .team__slider-miniatures-card {
        position: relative;

        &:after {
          content: '';
          position: absolute;
          inset: 0;
          background: var(--color-bg-primary);
          opacity: 0.6;
        }
      }
    }

    .team__slider-buttons {
      /* padding-inline: 45px; */
      position: absolute;
      top: 44%;
      left: 0;
      width: 100%;
      display: flex;
      justify-content: space-between;
      z-index: 20;
      transform: translateY(-50%);
      pointer-events: none;

      &:before,
      &:after {
        content: '';
        position: absolute;
        top: 50%;
        height: 368px;
        width: 40px;
        opacity: 0.6;
        z-index: 10;
        transform: translateY(-50%);
      }

      &:after {
        left: 0;
        background: linear-gradient(90deg, #0d0d0d 0%, rgba(13, 13, 13, 0) 100%);
      }

      &:before {
        right: 0;
        background: linear-gradient(270deg, #0d0d0d 0%, rgba(13, 13, 13, 0) 100%);
      }
    }

    /* Стилизуем как хотим */
    .team__slider-prev-btn,
    .team__slider-next-btn {
      width: 34px;
      height: 34px;
      padding: 0;
      background: transparent;
      color: #fff;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
      pointer-events: auto;
      z-index: 20;
    }
  }

  @media (--mobile) {
    .team__slider-mobile {
    }
    .team__slider-main {
      max-width: 140px;
      background: var(--color-bg-primary);
    }
    .team__slider-card {
      display: flex;
      flex-direction: column;
      row-gap: 4px;
    }
    .team__slider-image {
      width: 140px;
      height: 140px;

      .frame {
        width: 100%;
        height: 100%;
      }
    }

    .team__slider-buttons {
      padding-inline: 8px;

      &:before,
      &:after {
        content: '';
        position: absolute;
        top: 50%;
        height: 140px;
        width: 40px;
        opacity: 0.6;
        z-index: 10;
        transform: translateY(-50%);
      }
    }

    /* Стилизуем как хотим */
    .team__slider-prev-btn,
    .team__slider-next-btn {
      width: 24px;
      height: 24px;
    }
  }
</style>

