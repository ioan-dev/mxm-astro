---
import ConnectionsForm from './ConnectionsForm.astro';
---

<div class="modal">
  <div class="grid">
    <div class="modal__inner">
      <ConnectionsForm />
    </div>
  </div>

  <p class="modal__caption caption text-color-secondary">
    *Instagram — проект компании Meta Platforms Inc., признанной экстремистской организацией и
    запрещённой в РФ
  </p>
</div>

<style>
  .modal {
    width: 100%;
    position: fixed;
    inset: 0;
    background: rgba(13, 13, 13, 0.9);
    backdrop-filter: blur(50px);
    z-index: 10;
    opacity: 0;
    visibility: hidden;
  }

  .modal .grid {
    height: 100%;
  }

  .modal--active {
    opacity: 1;
    visibility: visible;
  }

  .modal__inner {
    grid-column: 5 / span 4;
    display: flex;
    justify-content: center;
  }

  .modal__caption {
    position: absolute;
    left: 50%;
    bottom: var(--spacing-3);
    transform: translateX(-50%);
  }
</style>

<script>
  let modal = document.querySelector('.modal');

  let btnHeader = document.querySelector('[data-header="modal"]');
  let btnModalClose = document.querySelector('[data-header="modal-close"]');

  btnHeader?.addEventListener('click', (event) => {
    event.currentTarget.classList.toggle('is-active');
    modal?.classList.toggle('modal--active');
    btnModalClose?.classList.toggle('is-show');
  });

  btnModalClose?.addEventListener('click', () => {
    btnHeader?.classList.remove('is-active');
    modal?.classList.remove('modal--active');
    btnModalClose?.classList.remove('is-show');
  });
</script>
