---
import Button from './Button.astro';

const { headline = '' } = Astro.props;
const { socialLinks = [] } = Astro.props;
---

<section class="connection">
  <div class="wrapper">
    <div class="grid">
      <div class="connection__title">
        <h2 class="heading-medium">{headline}</h2>
      </div>

      <div class="connection__body">
        <div class="connection__contacts">
          <ul class="connection__list" role="list">
            {
              socialLinks.map((link: any) => {
                return (
                  <li>
                    <a class="label-medium" href={link.link}>
                      {link.name}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>
        <div class="connection__form">
          <form class="form">
            <div class="form__field">
              <label class="form__label" for="">Имя</label>
              <input class="form__input" type="text" name="name" id="" placeholder="Имя" />
            </div>
            <div class="form__field">
              <label class="form__label" for="geo">Местоположение</label>
              <input
                class="form__input"
                type="text"
                name="geo"
                id=""
                placeholder="Местоположение"
              />
            </div>
            <div class="form__field">
              <label class="form__label" for="">Почта</label>
              <input class="form__input" type="email" name="email" id="" placeholder="Почта" />
            </div>
            <div class="form__field">
              <label class="form__label" for="">В чём заключается задача</label>
              <textarea
                class="form__input form__input--task"
                cols="30"
                rows="10"
                placeholder="Почта"
                placeholder="В чём заключается задача"></textarea>
            </div>
            <Button size="large">Отправить</Button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .connection {
    margin-bottom: -160px;
  }
  .connection__title {
    grid-column: span 3;
    max-width: 280px;
  }

  .connection__body {
    display: flex;
    flex-direction: column;
    row-gap: var(--spacing-8);
    grid-column: 7 / span 6;
  }
  .connection__form {
    display: flex;
    flex-direction: column;
    row-gap: var(--spacing-m);
  }

  .connection__list {
    display: flex;
    column-gap: var(--spacing-8);
  }

  .form {
    display: flex;
    flex-direction: column;
    row-gap: var(--spacing-4);
  }

  .form__label {
    display: none;
  }

  .form__input {
    font-family: var(--font-vela);
    font-size: 15px;
    line-height: var(--lh-small);
    letter-spacing: var(--ls-medium);
    color: var(--color-text-secondary);
    width: 100%;
    padding: var(--spacing-2);
    background: var(--color-bg-secondary);
    border-width: medium;
    border-style: none;
    border-color: currentcolor;
    border-image: initial;
    border-radius: var(--border-radius-m);
  }

  .form__input--task {
    resize: none;
  }

  @media (--tablet) {
    .connection {
      margin-bottom: 0px;

      .grid {
        row-gap: var(--spacing-4);
      }
    }
    .connection__title {
      grid-column: span 4;
    }
    .connection__body {
      flex-direction: column-reverse;
      grid-column: span 4;
    }

    .form {
      row-gap: var(--spacing-1);
    }
    .form__input {
      font-size: 9px;
    }
  }
</style>
