---
import { ASSETS_URL } from '../lib/constants';
import { Image } from '@unpic/astro';
let { projectTitle, projectDate, image, layout = 'default' } = Astro.props;

const layoutClasses = {
  default: 'hero--default',
  full: 'hero--full',
  right: 'hero--right',
};

// Валидация пропса
const validLayouts = ['default', 'full', 'right'];
const currentLayout = validLayouts.includes(layout) ? layout : 'default';
---

{
  layout === 'default' && (
    <div class:list={['flow', 'hero', layoutClasses[layout]]}>
      <div class="hero__title-wrapper">
        <h1 class="heading-large">{projectTitle}</h1>
        <span class="text-small">{projectDate}</span>
      </div>
      <div class="frame" data-frame-type="landscape">
        <Image alt="" layout="fullWidth" src={`${ASSETS_URL}/${image}`} cdn="directus" />
      </div>
    </div>
  )
}

{
  layout === 'full' && (
    <div class:list={['hero', layoutClasses[layout]]}>
      <div class="wrapper">
        <div class="hero__title-wrapper">
          <h1 class="heading-large">{projectTitle}</h1>
          <span class="text-small">{projectDate}</span>
        </div>
        <div class="frame" data-frame-type="large-format">
          <Image alt="" layout="fullWidth" src={`${ASSETS_URL}/${image}`} cdn="directus" />
        </div>
      </div>
    </div>
  )
}

{
  layout === 'right' && (
    <div class:list={['hero', layoutClasses[layout]]}>
      <div class="wrapper">
        <div class="grid">
          <div class="hero__title-wrapper">
            <h1 class="heading-large">{projectTitle}</h1>
            <span class="text-small">{projectDate}</span>
          </div>
          <div class="frame" data-frame-type="large-format">
            <Image alt="" layout="fullWidth" src={`${ASSETS_URL}/${image}`} cdn="directus" />
          </div>
        </div>
      </div>
    </div>
  )
}

<div class="hero__mobile">
  <div class="hero__title-wrapper">
    <h1 class="heading-large">{projectTitle}</h1>
    <span class="text-small">{projectDate}</span>
  </div>
  <div class="frame" data-frame-type="large-format">
    <Image alt="" layout="fullWidth" src={`${ASSETS_URL}/${image}`} cdn="directus" />
  </div>
</div>

<style>
  .hero {
    --flow-space: var(--spacing-16);
  }

  .hero__title-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);

    h1 {
      line-height: var(--lh-micro);
    }
  }

  .hero--full {
    position: relative;

    .hero__title-wrapper {
      position: absolute;
      left: var(--spacing-4);
      top: 180px;
      z-index: 10;
    }

    .frame {
      position: relative;

      &::after {
        position: absolute;
        content: '';
        inset: 0;
        background: linear-gradient(rgb(13, 13, 13), rgba(13, 13, 13, 0) 100%);
      }
    }
  }

  .hero--right {
    position: relative;

    .hero__title-wrapper {
      position: absolute;
      top: 0;
      left: var(--spacing-4);
    }
    .frame {
      aspect-ratio: 8 / 5;
      width: 100%;
      grid-column: 5 / span 8;
    }
  }

  @media (--tablet-above) {
    .hero__mobile {
      display: none;
    }
  }

  @media (--tablet) {
    .hero {
      display: none;
    }

    .hero__mobile {
      --flow-space: 0px;
      height: 100svh;
      position: relative;

      display: flex;
      flex-direction: column;
      justify-content: flex-end;

      padding-bottom: 48px;

      &::after {
        content: '';
        height: 35.088vh;
        width: 100%;
        position: absolute;
        left: 0;
        bottom: -2px;
        background: linear-gradient(180deg, rgba(13, 13, 13, 0) 0%, #0d0d0d 100%);

        z-index: 5;
      }

      .hero__title-wrapper {
        position: relative;
        z-index: 10;
        padding-inline: var(--spacing-4);
      }

      .frame {
        height: 100%;
        width: 100%;
        position: absolute;
        inset: 0;
      }
    }
  }
</style>
