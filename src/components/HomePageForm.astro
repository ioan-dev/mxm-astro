---
const { headline = '' } = Astro.props.item || {};
import ConnectionsForm from './ConnectionsForm.astro';
const { socialLinks = [] } = Astro.props;
---

<section class="connection">
  <div class="wrapper">
    <div class="grid">
      <div class="connection__title">
        <h2 class="heading-medium">{headline}</h2>
      </div>
      <div class="connection__inner">
        <ConnectionsForm socialLinks={socialLinks} />
      </div>
    </div>
  </div>
</section>

<style>
  .connection {
    margin-bottom: -160px;
  }
  .connection__title {
    grid-column: span 3;
    max-width: 280px;
  }

  .connection__inner {
    grid-column: 7 / span 6;
  }

  /* Responsive */

  @media (--tablet) {
    .connection {
      margin-bottom: 0px;

      .grid {
        row-gap: var(--spacing-8);
      }
    }
    .connection__title {
      grid-column: span 4;
    }
  }

  @media (--mobile) {
    .connection__inner {
      grid-column: span 4;
    }
  }
</style>
